# homelab-relay configuration. Copy to .env and fill in. Never commit .env.
#
# Outputs and what each platform is sent (resolution, frame rate, bitrate)
# are in relay.yaml, which is committed. This file holds ports, paths, URLs
# and keys. Both platforms compile them through the same code
# (relay.config):
#   Windows: scripts\up.ps1 into the NSSM services' environment.
#   Linux:   scripts/up.sh starts docker compose; each container builds its
#            environment at start (relay.run).
# Re-run up after any change here.
#
# Ports come from homelab-infra registry.yaml (services.stream-relay).

# Status page HTTP port (registry: stream-relay upstream.port). REQUIRED.
SERVICE_PORT=20040
# RTMP ingest port (registry: stream-relay native_ports.tcp). REQUIRED.
RTMP_PORT=1935
# MediaMTX API port, on loopback only: the outputs and status page poll it.
# Optional (default 9997).
RELAY_API_PORT=9997

# Ingest key: the stream key OBS sends, i.e. batw's STREAM_KEY_LIVE.
# A LAN shared secret, not a platform credential. REQUIRED, and up.ps1 refuses
# this placeholder.
# Letters, digits, "_", "." and "-" only: MediaMTX refuses any other character
# (base64 "=" and "+" included), and up.ps1 checks this. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_KEY=change-me-to-match-batw-STREAM_KEY_LIVE

# Archive storage root: one MPEG-TS file per ingest session, never
# re-encoded. Outside the repo. Created by up.ps1 / up.sh if missing. A host
# path on both platforms (Linux bind-mounts it). REQUIRED.
RECORD_DIR=D:\RelayRecordings
# Status page warns when free space at RECORD_DIR drops below this. Optional.
RECORD_MIN_FREE_GB=20

# Push-side I/O timeout in seconds: a stalled platform connection is dropped
# and retried after this long. Optional.
OUTPUT_IO_TIMEOUT=10

# This machine's own hostname, which OBS publishes to (shown on the status
# page with the RTMP port). Never a status-page vhost such as
# stream-relay.stanley.arpa: those resolve to the nginx host, not here.
# Optional (default: this machine's fully qualified name).
RELAY_INGEST_HOST=

# Video encoder for every rendition in relay.yaml. Optional (default
# h264_nvenc, the NVIDIA GPU). libx264 is for running test\acceptance.py on
# a host with no NVIDIA GPU, never for a broadcast. `copy` makes this host
# forward ingest untouched to every output, ignoring relay.yaml's renditions:
# the stream-copy fallback on adler. OBS then sets every platform's bitrate,
# so it must stay under the lowest max_kbps (up prints them).
VIDEO_ENCODER=h264_nvenc

# Full path to python.exe (3.11 or later), used once to create .venv.
# Optional: otherwise python.exe or py.exe on PATH.
RELAY_PYTHON_EXE=

# Binaries. Optional: by default the pinned builds that scripts\fetch-tools.ps1
# puts in tools\ (fetched by up.ps1). Override only to test another build.
FFMPEG_EXE=
MEDIAMTX_EXE=

# Where the outputs write their progress reports for the status page.
# Optional (default: state\ in the repo).
RELAY_STATE_DIR=

# --- Platform outputs ------------------------------------------------------
# An output runs only when both its URL and its key are set. Clear a key to
# leave that platform out of a broadcast, then re-run up.ps1 (it restarts
# only that output). Keys are real credentials.
#
# URLs checked 2026-09-23; confirm against each platform's dashboard.

# Optional. Twitch global ingest (from https://ingest.twitch.tv/ingests).
TWITCH_URL=rtmps://ingest.global-contribute.live-video.net/app
STREAM_KEY_TWITCH=

# Optional. YouTube Studio > Live > Stream settings (RTMPS URL).
YOUTUBE_URL=rtmps://a.rtmps.youtube.com/live2
STREAM_KEY_YOUTUBE=

# Optional. Facebook Live Producer (RTMPS only).
FACEBOOK_URL=rtmps://live-api-s.facebook.com:443/rtmp
STREAM_KEY_FACEBOOK=

# --- Test sinks --------------------------------------------------------------
# Leave empty for real broadcasts. A sink runs whenever its URL is set; it has
# no key. test\acceptance.py runs its own sinks and does not use these.
# TLS verification may be turned off ONLY for a self-signed test sink.

# Optional.
SINK_A_URL=
SINK_A_TLS_VERIFY=true
# Optional.
SINK_B_URL=
SINK_B_TLS_VERIFY=true

# --- Linux (Docker) only ------------------------------------------------------
# Image tag scripts/build.sh produced and the acceptance checks passed.
# REQUIRED on Linux; up.sh never builds.
RELAY_IMAGE_TAG=
# User the containers run as; must be able to write RECORD_DIR. Optional.
RELAY_UID=1000
RELAY_GID=1000
