# homelab-relay configuration. Copy to .env and fill in. Never commit .env.
#
# Ports come from homelab-infra registry.yaml (services.stream-relay).

# Status page HTTP port (registry: stream-relay upstream.port). REQUIRED.
SERVICE_PORT=20040
# RTMP ingest port (registry: stream-relay native_ports.tcp). REQUIRED.
RTMP_PORT=1935

# Ingest key: the stream key OBS sends, i.e. batw's STREAM_KEY_LIVE.
# A LAN shared secret, not a platform credential. REQUIRED.
INGEST_KEY=change-me-to-match-batw-STREAM_KEY_LIVE

# Archive storage root on the host, outside the repo. REQUIRED.
RECORD_DIR=/srv/homelab-relay/recordings
# Status page warns when free space at RECORD_DIR drops below this. Optional.
RECORD_MIN_FREE_GB=20

# Push-side I/O timeout in seconds: a stalled platform connection is dropped
# and retried after this long. Optional.
OUTPUT_IO_TIMEOUT=10

# UID/GID the relay processes run as; recordings are owned by this user.
# Optional (default 1000).
RELAY_UID=1000
RELAY_GID=1000

# --- Platform outputs ------------------------------------------------------
# An output runs only when both its URL and its key are set. Clear a key to
# leave that platform out of a broadcast. Keys are real credentials.
#
# URLs checked 2026-09-23; confirm against each platform's dashboard.

# Optional. Twitch global ingest (from https://ingest.twitch.tv/ingests).
TWITCH_URL=rtmps://ingest.global-contribute.live-video.net/app
STREAM_KEY_TWITCH=

# Optional. YouTube Studio > Live > Stream settings (RTMPS URL).
YOUTUBE_URL=rtmps://a.rtmps.youtube.com/live2
STREAM_KEY_YOUTUBE=

# Optional. Facebook Live Producer (RTMPS only).
FACEBOOK_URL=rtmps://live-api-s.facebook.com:443/rtmp
STREAM_KEY_FACEBOOK=

# --- Test sinks --------------------------------------------------------------
# Leave empty for real broadcasts. A sink runs whenever its URL is set; it
# has no key. Start the local sinks with: docker compose --profile sinks up -d
#   SINK_A_URL=rtmp://sink-a:1935/sink
#   SINK_B_URL=rtmps://sink-b:1936/sink  with SINK_B_TLS_VERIFY=false
# TLS verification may be turned off ONLY for a self-signed test sink.

# Optional.
SINK_A_URL=
SINK_A_TLS_VERIFY=true
# Optional.
SINK_B_URL=
SINK_B_TLS_VERIFY=true
